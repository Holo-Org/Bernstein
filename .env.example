# Copy to .env and fill in. .env is read by the scripts and must never be committed.

# Azure Container Registry name (without .azurecr.io), globally unique: `make registry` creates it.
# Optional when the subscription has a single registry: it is then detected automatically.
ACR_NAME=

# Password of the Redis queue, stored in the `redis` Secret.
REDIS_PASSWORD=

# Password of the PostgreSQL database, stored in the `postgres` Secret.
# Only applied when the database is created: changing it later requires ALTER USER as well.
POSTGRES_PASSWORD=
